# Supabase Configuration
# Get these from your Supabase project: Settings → API
# - URL: e.g. https://your-project-ref.supabase.co
# - anon key: the "anon public" key (safe to expose in browser)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# Google Sheets Sync (server-side only — for /api/google/sync)
# ============================================================================
# These are required for the "Google Sync" feature in the admin panel.
# They are read server-side only and never exposed to the browser.
#
# SETUP (one-time):
# 1. https://console.cloud.google.com/ → create or pick a project
# 2. APIs & Services → Library → enable:
#    - Google Sheets API
#    - Google Drive API
# 3. IAM & Admin → Service Accounts → Create
#    - Role: Editor (or just give Sheets/Drive access)
# 4. Service account → Keys tab → Add Key → JSON → download the JSON file
# 5. Open the JSON file in a text editor. Copy these two values:
#    - client_email  → GOOGLE_SERVICE_ACCOUNT_EMAIL
#    - private_key   → GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY (keep the quotes,
#                      keep the \n escapes — paste it verbatim)
# 6. Open your master template spreadsheet → Share → paste the service account
#    email → give Editor access
# 7. Copy the Spreadsheet ID from the URL:
#    https://docs.google.com/spreadsheets/d/[THIS_PART]/edit
#    → GOOGLE_TEMPLATE_SPREADSHEET_ID
# 8. Add all 4 variables in Vercel → Settings → Environment Variables
# 9. Redeploy

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_TEMPLATE_SPREADSHEET_ID=

# ============================================================================
# Supabase Service Role Key (server-side only)
# Required for the Google Sync API route to read all cleaning records
# (bypasses RLS so the server can export data for any user).
# Get it from Supabase → Settings → API → service_role key.
# ⚠️ NEVER expose this in the browser. Only use in /api routes.
# ============================================================================

SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Cron Secret (for monthly auto-duplicate)
# A random string that protects the /api/cron/monthly-duplicate endpoint.
# Vercel Cron will call this endpoint on the 1st of each month.
# Generate one: openssl rand -hex 32
# ============================================================================

CRON_SECRET=

